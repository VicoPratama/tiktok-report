# From TikTok for Developers > your app
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must exactly match a redirect URI registered in the TikTok app (HTTPS in production)
REDIRECT_URI=https://your-domain.com/auth/tiktok/callback

# Protects the dashboard and API (browser shows a login prompt; username is ignored)
DASHBOARD_PASSWORD=change-me

PORT=3000
SYNC_MINUTES=30
# Optional: pull the song name from the caption. Group 1 is the song.
# Example caption: "summer vibes 🎵 Song: Surfin'"
SONG_REGEX=song:\s*([^\n#]+)
